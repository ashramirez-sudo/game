[gd_scene load_steps=2 format=3 uid="uid://c54bi7gjcgp5c"]

[sub_resource type="GDScript" id="GDScript_sgc6v"]
resource_name = "song_select_menu.gd"
script/source = "extends Control
@onready var song_card_scene = preload(\"res://levels/song_card.tscn\")
@onready var song_list_container = %SongListContainer
func _ready():
	populate_song_list()
func populate_song_list():
	# Clear any old buttons
	for child in song_list_container.get_children():
		child.queue_free()
		
	# Loop through all songs in SongManager
	for song_id in SongManager.songs.keys():
		var card_inst = song_card_scene.instantiate()
		song_list_container.add_child(card_inst)
		card_inst.setup(song_id, SongManager.songs[song_id])
		
		# Connect button click
		card_inst.song_selected.connect(_on_song_card_selected)
func _on_song_card_selected(song_id: String):
	SongManager.selected_song_id = song_id
	var song_info = SongManager.get_selected_song()
	
	# Play music preview
	if song_info.get(\"music\"):
		$PreviewPlayer.stream = song_info.get(\"music\")
		$PreviewPlayer.play(10.0) # Start preview 10 seconds in
func _on_play_button_pressed():
	# Load game level
	get_tree().change_scene_to_file(\"res://levels/game_level.tscn\")
"

