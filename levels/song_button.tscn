[gd_scene load_steps=2 format=3 uid="uid://dcrda8j0kbsu5"]

[sub_resource type="GDScript" id="GDScript_bu8ng"]
resource_name = "song_card.gd"
script/source = "extends Button
signal song_selected(song_id: String)
var song_id: String = \"\"
func setup(id: String, song_info: Dictionary):
	song_id = id
	$HBoxContainer/VBoxContainer/TitleLabel.text = song_info.get(\"title\", \"Unknown Title\")
	$HBoxContainer/VBoxContainer/ArtistLabel.text = song_info.get(\"artist\", \"Unknown Artist\")
	$HBoxContainer/VBoxContainer/DifficultyLabel.text = \"Difficulty: \" + song_info.get(\"difficulty\", \"Normal\")
	
	if song_info.get(\"cover\"):
		$HBoxContainer/TextureRect.texture = song_info.get(\"cover\")
func _on_pressed():
	song_selected.emit(song_id)
"

[node name="SongButton" type="Node2D"]
