func _ready():
	if get_node_or_null("/root/GlobalState"):
		in_edit_mode = GlobalState.in_edit_mode
		current_level_name = GlobalState.current_level_name

	var level = level_info.get(current_level_name)
	if level == null or level.get("music") == null:
		push_error("Invalid level data or music path.")
		return
		
	var stream = load(level.get("music"))
	if stream == null:
		push_error("Failed to load music resource at path: %s" % level.get("music"))
		return
		
	$MusicPlayer.stream = stream
	$MusicPlayer.play()

	if in_edit_mode:
		Signals.KeyListenerPress.connect(KeyListenerPress)
	else:
		load_level_notes(level.get("fk_times"))

@warning_ignore("unused_parameter")
func KeyListenerPress(button_name: String, array_num: int):
	var current_pos = $MusicPlayer.get_playback_position()
	var spawn_time = max(0.0, current_pos - fk_fall_time)
	fk_output_arr[array_num].append(snapped(spawn_time, 0.01))

func load_level_notes(fk_times_str):
	if typeof(fk_times_str) != TYPE_STRING:
		return
		
	var fk_times_arr = str_to_var(fk_times_str)
	if not fk_times_arr is Array:
		return

	var buttons = ["button_D", "button_F", "button_J", "button_K"]
	for i in range(min(fk_times_arr.size(), buttons.size())):
		if fk_times_arr[i] is Array:
			for delay in fk_times_arr[i]:
				SpawnFallingKey(buttons[i], float(delay))

func SpawnFallingKey(button_name: String, delay: float):
	await get_tree().create_timer(delay).timeout
	Signals.CreateFallingKey.emit(button_name)

func _on_music_player_finished():
	if in_edit_mode:
		var formatted_string = var_to_str(fk_output_arr)
		level_info[current_level_name]["fk_times"] = formatted_string
		
		save_chart_to_json("user://%s_chart.json" % current_level_name)

func save_chart_to_json(path: String):
	var file = FileAccess.open(path, FileAccess.WRITE)
	if file:
		var json_string = JSON.stringify(fk_output_arr, "\t")
		file.store_string(json_string)
		file.close()
		print("[LevelEditor] Chart successfully exported to: ", path)
		print("[LevelEditor] Absolute system directory: ", OS.get_user_data_dir())
	else:
		push_error("[LevelEditor] Failed to save JSON file. Error code: %d" % FileAccess.get_open_error())
